<article id="<%= dom_id blog_post %>" class="post-card">
  <% if blog_post.banner_image.attached? %>
    <%= image_tag blog_post.banner_image, class: "post-card__image", alt: blog_post.title %>
  <% end %>
  <div class="post-card__content">
    <p class="eyebrow">From the journal</p>
    <h2 class="post-card__title"><%= link_to blog_post.title.presence || "Untitled post", blog_post %></h2>
    <p class="post-card__excerpt"><%= truncate(blog_post.body.to_plain_text, length: 150) %></p>
    <% if blog_post.tags.present? %>
      <p class="post-meta"><%= blog_post.tags %></p>
    <% end %>
    <div class="post-card__actions">
      <%= link_to "Read post", blog_post, class: "button" %>
      <%= link_to "Edit", edit_blog_post_path(blog_post), class: "button button--secondary" %>
      <%= button_to "Delete", blog_post, method: :delete, class: "button button--danger", form_class: "button_to--danger", data: { turbo_confirm: "Delete this post? This cannot be undone." } %>
    </div>
  </div>
</article>
